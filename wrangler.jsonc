{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "satisfying-relationships",
  "compatibility_date": "2026-09-30",
  "main": "src/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "vars": {
    "CONTACT_TO_EMAIL": "dklormand@gmail.com",
    "CONTACT_FROM_EMAIL": "Satisfying Relationships <no-reply@satisfyingrelationships.com>"
  }
}
